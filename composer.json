{
    "name": "smkn1sebulu/sisfo",
    "type": "project",
    "description": "Sistem Informasi SMK Negeri 1 Sebulu — CMS, PPDB, Sistem Pakar, SPK, Theme Manager, Reporting.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/breeze": "^2.0",
        "barryvdh/laravel-dompdf": "^2.2",
        "maatwebsite/excel": "^3.1",
        "thiagoalessio/tesseract_ocr": "2.13"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "phpunit/phpunit": "^11.0",
        "laravel/pail": "^1.2",
        "nunomaduro/collision": "^8.9",
        "laravel/tinker": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "audit": {
            "block-insecure": false
        }
    }
}
